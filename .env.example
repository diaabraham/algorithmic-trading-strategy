POLYGON_API_KEY=your_polygon_api_key_here

# IBKR / TWS or IB Gateway config
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_TIMEOUT=15
IBKR_READONLY=false
# Optional: full Contract fields as JSON for futures/options (overrides symbol routing), e.g.
# IBKR_CONTRACT_JSON={"symbol":"MES","secType":"FUT","exchange":"CME","currency":"USD","lastTradeDateOrContractMonth":"202506"}

# FX for CAD notionals in portfolio Monte Carlo (spot approximation)
CAD_USD_FX=0.74

# Safety gate for live orders
LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true
MAX_ORDER_QTY=10
MAX_NOTIONAL_PER_ORDER=25000

# Optional research sentiment inputs
ALPHAVANTAGE_API_KEY=
